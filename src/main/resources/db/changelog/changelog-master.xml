<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!--
    =============================================================================
    Knowledge Engine - Database Schema Changelog
    =============================================================================

    This changelog applies the complete Knowledge Engine database schema from
    a single consolidated SQL file that serves as the source of truth.

    Schema Version: 3.1 (DTO-Prompt-Entity Alignment)
    Last Updated: 2026-06-03

    The schema includes all tables for:
    - Core: projects, documents, source chunks
    - Knowledge: domains, subdomains, components, workflows
    - Business Concepts: capabilities, roles, terms, policies, decisions, metrics, notes
    - Architecture: APIs, data models, integrations
    - Relationships: knowledge_relationships (cross-entity links)
    - Analysis: shared entities, conflicts, gaps

    =============================================================================
    -->

    <changeSet id="knowledge-engine-schema-v3.1" author="kengine">
        <comment>Apply complete Knowledge Engine schema v3.1 with DTO-Prompt-Entity alignment</comment>
        <sqlFile
            path="db/changelog/sql/project-centered-schema.sql"
            relativeToChangelogFile="false"
            splitStatements="true"
            stripComments="false"/>
        <rollback>
            DROP SCHEMA IF EXISTS knowledge CASCADE;
        </rollback>
    </changeSet>

</databaseChangeLog>
